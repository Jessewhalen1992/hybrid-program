<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <!-- basic properties -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform      Condition=" '$(Platform)'     == '' ">AnyCPU</Platform>
    <!-- List all configurations and platforms we support -->
    <Configurations>Debug;Release;Release2015</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
    <ProjectGuid>{099E609C-544E-4EF2-A444-E06DF5668CE3}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Hybrid_Program</RootNamespace>
    <AssemblyName>HybridProgram</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <Deterministic>true</Deterministic>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>

  <!-- Debug x64 -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <!-- Release x64 -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <!-- Release 2015 x64 -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release2015|x64'">
    <OutputPath>bin\x64\Release2015\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE;ACAD_2015</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <!-- Removed Release 2025 configuration -->

  <!-- project configurations -->
  <ItemGroup>
    <ProjectConfiguration Include="Release2015|x64">
      <Configuration>Release2015</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <!-- Removed Release2025 project configuration -->
  </ItemGroup>

  <!-- references -->
  <ItemGroup>
    <!-- AutoCAD API assemblies – copy to output so ILRepack can see them -->
    <Reference Include="accoremgd">
      <HintPath Condition="'$(Configuration)'=='Release2015'">C:\Program Files\Autodesk\AutoCAD 2015\accoremgd.dll</HintPath>
      <!-- Removed Release2025 hint path -->
      <!-- Default to the AutoCAD 2015 location -->
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2015\accoremgd.dll</HintPath>
      <!-- Copy the AutoCAD DLL to output only for Debug builds; for Release builds it is loaded from AutoCAD installation -->
      <Private Condition="'$(Configuration)'=='Debug'">True</Private>
      <Private Condition="'$(Configuration)'!='Debug'">False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath Condition="'$(Configuration)'=='Release2015'">C:\Program Files\Autodesk\AutoCAD 2015\acdbmgd.dll</HintPath>
      <!-- Removed Release2025 hint path -->
      <!-- Default to the AutoCAD 2015 location -->
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2015\acdbmgd.dll</HintPath>
      <!-- Copy the AutoCAD DLL to output only for Debug builds -->
      <Private Condition="'$(Configuration)'=='Debug'">True</Private>
      <Private Condition="'$(Configuration)'!='Debug'">False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath Condition="'$(Configuration)'=='Release2015'">C:\Program Files\Autodesk\AutoCAD 2015\acmgd.dll</HintPath>
      <!-- Removed Release2025 hint path -->
      <!-- Default to the AutoCAD 2015 location -->
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2015\acmgd.dll</HintPath>
      <!-- Copy the AutoCAD DLL to output only for Debug builds -->
      <Private Condition="'$(Configuration)'=='Debug'">True</Private>
      <Private Condition="'$(Configuration)'!='Debug'">False</Private>
    </Reference>

    <!-- Json.NET – will be merged -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>packages\Newtonsoft.Json.13.0.3\lib\net45\Newtonsoft.Json.dll</HintPath>
    </Reference>

    <!-- framework -->
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- sources -->
  <ItemGroup>
    <Compile Include="Main Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <None    Include="packages.config" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- ILRepack MSBuild task -->
  <Import Project="packages\ILRepack.Lib.MSBuild.Task.2.0.40\build\ILRepack.Lib.MSBuild.Task.targets"
          Condition="Exists('packages\ILRepack.Lib.MSBuild.Task.2.0.40\build\ILRepack.Lib.MSBuild.Task.targets')" />

  <!-- merge after successful build -->
  <Target Name="ILRepackMerge"
          AfterTargets="Build"
          Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">

    <ItemGroup>
      <InputAssemblies Include="$(TargetPath)" />
      <InputAssemblies Include="$(TargetDir)Newtonsoft.Json.dll" />
    </ItemGroup>

    <!-- ***** ONLY CHANGE IS HERE: using LibraryPath instead of unsupported Libs ***** -->
    <ILRepack
      InputAssemblies="@(InputAssemblies)"
      OutputFile      ="$(TargetDir)HybridProgram_One.dll"
      Internalize     ="true"
      DebugInfo       ="true"
      Parallel        ="true"
      TargetKind      ="SameAsPrimaryAssembly"
      LibraryPath     ="$(TargetDir)" />
  </Target>

  <!-- stop early if the ILRepack package is missing -->
  <Target Name="EnsureILRepackPresent" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('packages\ILRepack.Lib.MSBuild.Task.2.0.40\build\ILRepack.Lib.MSBuild.Task.targets')"
           Text="ILRepack MSBuild package is missing – run 'Restore NuGet Packages'." />
  </Target>

</Project>
